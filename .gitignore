build/
build-win/
build-vita/
dist/
*.inc
__pycache__/

# Internal working notes stay local; only the screenshots are published.
docs/*
!docs/screenshots/
!docs/CODING_STYLE.md

# Android build outputs (CI builds these from source).
platforms/android/.gradle/
platforms/android/.idea/
platforms/android/local.properties
platforms/android/*/build/
platforms/android/app/libs/
platforms/android/app/src/main/jniLibs/
platforms/android/app/src/main/assets/

# Release signing material stays local; CI reads it from repository secrets.
platforms/android/melee-release.keystore
platforms/android/release-signing.env

# Proton/wine leavings from tools/run_proton.sh.
vkd3d-proton.cache*
steam_appid.txt

# User-supplied retail game/disc data must never enter source control.
*.iso
*.gcm
*.ciso
*.rvz
*.wbfs
*.dol

# Generated Giga Bowser CSP textures are source assets for the Vita build.
!src/melee/mn/giga_bowser_csp_re.inc
!src/melee/mn/giga_bowser_csp_bu.inc
!src/melee/mn/giga_bowser_csp_bk.inc
!src/melee/mn/giga_bowser_csp_ye.inc
!src/melee/mn/giga_bowser_csp_wh.inc